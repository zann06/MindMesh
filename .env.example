# MindMesh web app environment (all optional)
# Do not put provider API keys here for a public deployment. Use the Settings UI
# and understand that browser-stored keys are visible to the local browser profile.

# Local OpenCode bridge URL shown as the default in Settings.
VITE_BRIDGE_URL=http://127.0.0.1:4319

# Development convenience only. When set, the Settings page pre-fills the bridge
# token. This token is compiled into the client bundle, so never use it as a
# secret for a public deployment.
# VITE_MINDMESH_BRIDGE_TOKEN=

# Local bridge process configuration. Set a stable token to avoid copying the
# generated per-run token into the UI. Bind only to loopback.
# MINDMESH_BRIDGE_PORT=4319
# MINDMESH_BRIDGE_TOKEN=
# Comma-separated allowed browser origins.
# MINDMESH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# OPENCODE_BIN=C:\path\to\opencode.exe
