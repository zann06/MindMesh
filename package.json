{
  "name": "mindmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Turn what you read into what you understand. A local-first, evidence-backed 3D knowledge universe.",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "bridge": "node bridge/server.mjs",
    "dev:all": "concurrently -k -n bridge,web -c cyan,magenta \"npm:bridge\" \"npm:dev\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "keywords": [
    "knowledge-graph",
    "learning",
    "3d",
    "pdf",
    "local-first",
    "opencode"
  ],
  "author": "MindMesh contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zann06/MindMesh.git"
  },
  "homepage": "https://zann06.github.io/MindMesh/",
  "bugs": {
    "url": "https://github.com/zann06/MindMesh/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "motion": "^14.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
